<Project Sdk="Microsoft.NET.Sdk">

  <!-- Local web GUI over the pipeline, AdvancedStudio-dashboard style: loopback
       HttpListener + one self-contained HTML page, zero packages. obcslice and
       obc3mf run in-process; fieldengine runs as a subprocess (it needs the
       PicoGK native stack, this project stays sandbox-testable without it). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>ObcSlicerUi</RootNamespace>
    <AssemblyName>obcslicer-ui</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\obcslice\obcslice.csproj" />
    <ProjectReference Include="..\obc3mf\obc3mf.csproj" />
    <ProjectReference Include="..\obcslicer-mcp\obcslicer-mcp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="ui.html" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
